name: 部署 Flask 应用

on:
  push:
    branches:
      - index  # 当 index 分支有新的推送时触发工作流
  workflow_dispatch:  # 允许手动触发工作流

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write  # 设置权限，允许写入内容，例如创建 Release

    steps:
    - name: 检出代码
      uses: actions/checkout@v3

    - name: 设置 Python 环境
      uses: actions/setup-python@v3
      with:
        python-version: 3.9  # 指定 Python 版本为 3.9
        cache: "pip"  # 缓存 pip 依赖

    - name: 安装依赖
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt

    - name: 安装 Nuitka 和 PyInstaller
      run: |
        python -m pip install nuitka pyinstaller

    - name: 使用 Nuitka 编译 Flask 应用
      run: |
        cd $GITHUB_WORKSPACE/server  # 确保在 Flask 应用的目录下
        python -m nuitka --onefile --standalone \
          --plugin-enable=numpy --plugin-enable=pylint-warnings \
          --include-package=flask --include-package=flask_cors app.py
        echo "Nuitka 编译完成，查看生成的文件夹内容："
        ls -la app.dist  # Nuitka 生成的 standalone 目录

    - name: 使用 PyInstaller 打包 Nuitka 输出
      run: |
        # 将 Nuitka 的输出文件打包成一个独立的可执行文件
        pyinstaller --onefile --name app_nuitka \
          --distpath $GITHUB_WORKSPACE/server/dist \
          $GITHUB_WORKSPACE/server/app.dist/app
        echo "PyInstaller 打包完成，查看 dist 文件夹内容："
        ls -la $GITHUB_WORKSPACE/server/dist

    - name: 检查打包结果
      run: |
        if [ -f "$GITHUB_WORKSPACE/server/dist/app_nuitka" ]; then
          echo "打包成功，找到二进制文件 dist/app_nuitka"
        else
          echo "打包失败，未找到 dist/app_nuitka"
          exit 1
        fi

    - name: 获取当前版本号
      id: get_version
      run: |
        # 获取最新的版本号标签
        current_version=$(git tag | grep '^v[0-9]\+\.[0-9]\+$' | sort -V | tail -n 1)

        # 如果没有找到版本号，默认为 v0.1
        if [ -z "$current_version" ]; then
          current_version="v0.1"
        fi

        # 提取版本号前缀和后缀
        version_prefix=${current_version%.*}
        version_suffix=${current_version##*.}

        # 递增后缀
        new_version_suffix=$((version_suffix + 1))

        # 拼接新的版本号
        new_version="${version_prefix}.${new_version_suffix}"

        echo "new_version=$new_version" >> $GITHUB_ENV
        echo "生成的新版本号: $new_version"  # 输出新的版本号

    - name: 检查是否已经存在 Release
      id: check_release
      run: |
        if git tag | grep -q "^${{ env.new_version }}$"; then
          echo "Release ${{ env.new_version }} 已存在."
          echo "skip_release=true" >> $GITHUB_ENV
        else
          echo "skip_release=false" >> $GITHUB_ENV
        fi

    - name: 创建 Release
      if: env.skip_release == 'false'
      id: create_release
      uses: actions/create-release@v1
      with:
        tag_name: ${{ env.new_version }}
        release_name: ${{ env.new_version }}
        draft: false
        prerelease: false
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

    - name: 上传打包文件到 Release
      if: env.skip_release == 'false'
      uses: actions/upload-release-asset@v1
      with:
        upload_url: ${{ steps.create_release.outputs.upload_url }}
        asset_path: ${{ github.workspace }}/server/dist/app_nuitka
        asset_name: app_nuitka_${{ env.new_version }}
        asset_content_type: application/octet-stream
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

    - name: 上传打包文件为 Artifact
      uses: actions/upload-artifact@v3
      with:
        name: flask-app_nuitka_${{ env.new_version }}
        path: ${{ github.workspace }}/server/dist/app_nuitka
