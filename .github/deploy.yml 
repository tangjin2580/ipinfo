name: 部署 Flask 应用

on:
  push:
    branches:
      - main  # 当 main 分支有新的推送时触发工作流
  workflow_dispatch:  # 允许手动触发工作流

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: 检出代码
      uses: actions/checkout@v2

    - name: 设置 Python 环境
      uses: actions/setup-python@v2
      with:
        python-version: 3.8  # 指定 Python 版本

    - name: 安装依赖
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt

    - name: 安装 PyInstaller
      run: pip install pyinstaller

    - name: 打包 Flask 应用
      run: pyinstaller -F --hidden-import flask_cors --hidden-import requests --hidden-import dns.resolver --hidden-import country_mapping app.py

    - name: 上传打包文件为 artifact
      uses: actions/upload-artifact@v2
      with:
        name: ipinfo-flask-app
        path: dist/app  # 这里假设 PyInstaller 生成的文件名为 app
